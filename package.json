{
  "name": "pulse-rag",
  "private": true,
  "version": "0.1.0",
  "description": "简化版 Dify 平台（对外提供 RAG 服务的 API 应用）—— M1 monorepo 骨架",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @pulse/api test && pnpm --filter @pulse/contracts test",
    "db:generate": "pnpm --filter @pulse/db generate",
    "db:migrate": "pnpm --filter @pulse/db migrate",
    "db:push": "pnpm --filter @pulse/db push",
    "db:studio": "pnpm --filter @pulse/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}