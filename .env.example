# ------------------------------------------------------------------
# Pulse-Rag 环境变量样例 —— 复制为 .env 后按需修改
# ------------------------------------------------------------------

# --- 通用 ---
NODE_ENV=development

# --- PostgreSQL（docker-compose 默认值） ---
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
LOG_LEVEL=info

# --- M2 模型网关 ---
# 凭据字段级加密密钥（AES-256-GCM，必须为 64 位 hex）。生成：openssl rand -hex 32
MODEL_CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_-hex_32_output
# 置为 true 时全部 Provider 走本地 Mock（不发起真实请求，无外网可测）
MOCK_MODELS=false

# --- M7 开放 API 网关 ---
# 对外 API Key 明文前缀（如 rk），用于生成 / 识别密钥
API_KEY_PREFIX=rk
# 置为 true 时「管理类」路由也强制要求 API Key（默认仅对外调用类强制）
ENABLE_API_KEY_FOR_MANAGEMENT=false
# Redis 连接/命令超时(ms)：连接失败即降级为「放行 + 降级日志」，不阻塞业务
REDIS_CONNECT_TIMEOUT_MS=2000
# Redis 降级后重试冷却(ms)：到期后自动重连以恢复限流
REDIS_RETRY_INTERVAL_MS=30000

# --- M-A ReAct 工具循环 ---
# 工具循环最大轮数（每轮 = 一次工具决策 + 一次执行）；超限强制收敛到最终生成
AGENT_TOOL_MAX_ROUNDS=3

# --- M-C 第三方实时工具（OpenAlex 学术检索） ---
# 置为 true 时第三方实时工具（openalex_search 等）返回确定性假数据（无外网可测）
MOCK_TOOLS=false
# OpenAlex 免费 API Key（2026-02 起更稳；可选，不配也能跑 1rps）。申请：https://help.openalex.org/hc/articles/3104037477523
OPENALEX_API_KEY=
# OpenAlex 联络邮箱（mailto 走 polite pool 5rps 更稳；建议填真实邮箱以便 OpenAlex 联系）
OPENALEX_MAILTO=pulse-rag@example.com

# --- Web (Vite) ---
WEB_PORT=3002